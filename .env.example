# Copy file ini menjadi app/config/database.local.php lalu isi nilainya.
# JANGAN commit database.local.php (sudah ada di .gitignore).

# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection string
# Pilih "Session pooler" (port 5432).
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASS=password-kamu

# Daftarkan URL di Supabase Auth > URL Configuration.
# Tautan template Reset Password: {{ .RedirectTo }}?token_hash={{ .TokenHash }}
PUTU_PASSWORD_RESET_URL=https://putu.juan.web.id/app/pages/reset-password.php

# Alternatif: simpan ketiga nilai ini di app/config/telegram.local.php.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
APP_URL=https://putu.juan.web.id

# Hash SHA-256 kode akses Developer (32 karakter hex acak).
PUTU_DEVELOPER_CODE_HASH=
# Hostname Cloudflare Tunnel yang meneruskan HTTPS dari konektor loopback.
PUTU_DEVELOPER_TUNNEL_HOST=
